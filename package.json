{
  "name": "elfar-tasks",
  "productName": "Elfar Tasks",
  "version": "1.18.0",
  "description": "Elfar Tasks: a desktop to-do app with areas, subtasks, a priority matrix, follow-ups, reminders and a desktop widget",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "test": "node --test tests/logic.test.js tests/sync.test.js",
    "smoke": "node tests/smoke.js",
    "dist": "node --test tests/logic.test.js tests/sync.test.js && node tests/smoke.js && electron-builder --win nsis --publish never"
  },
  "license": "UNLICENSED",
  "private": true,
  "author": "Mamdouh Elfar",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elfar.notes",
    "productName": "Elfar Tasks",
    "copyright": "???? Mamdouh Elfar",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Elfar-Tasks-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elfar Tasks",
      "uninstallDisplayName": "Elfar Tasks"
    },
    "publish": [{ "provider": "github", "owner": "MamdouhElfar", "repo": "elfar-tasks", "releaseType": "release" }]
  }
}
